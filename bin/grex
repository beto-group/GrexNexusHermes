#!/usr/bin/env python3
"""Grex CLI — Sovereign Component & Telemetry Control Utility for Hermes."""

import sys
import json
import urllib.request

def _make_req(url, payload=None, timeout=300):
    headers = {"Content-Type": "application/json"}
    data_bytes = json.dumps(payload).encode("utf-8") if payload else None
    req = urllib.request.Request(url, data=data_bytes, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as response:
        return json.loads(response.read().decode("utf-8"))

def main():
    args = sys.argv[1:]
    if not args or args[0] in ["-h", "--help", "help"]:
        print("🛰️ Grex CLI — Sovereign Component & Telemetry Utility")
        print("\nCommands:")
        print("  grex status             Show sidecar daemon & container telemetry")
        print("  grex exec <command>     Execute command inside container")
        print("  grex host-exec <cmd>    Execute host OS command (manage Podman pods, build images)")
        print("  grex version            Show Grex Nexus version")
        return

    cmd = args[0].lower()
    endpoints_base = [
        "http://192.168.127.254:7777",
        "http://host.containers.internal:7777",
        "http://localhost:7777",
        "http://127.0.0.1:7777"
    ]

    if cmd == "status":
        for base in endpoints_base:
            try:
                data = _make_req(f"{base}/api/status", timeout=3)
                print(json.dumps(data, indent=2))
                return
            except Exception:
                continue
        print("Error querying status: Could not connect to sidecar daemon.")
    elif cmd in ["exec", "host-exec"]:
        sub_path = "/api/host/exec" if cmd == "host-exec" else "/api/exec"
        if len(args) < 2:
            print(f"Usage: grex {cmd} <command>")
            return
        cmd_str = " ".join(args[1:])
        for base in endpoints_base:
            try:
                res = _make_req(f"{base}{sub_path}", payload={"command": cmd_str}, timeout=300)
                print(f"Exit Code: {res.get('exit_code', 0)}")
                if res.get('stdout'):
                    print(f"Stdout:\n{res.get('stdout')}")
                if res.get('stderr'):
                    print(f"Stderr:\n{res.get('stderr')}")
                return
            except Exception:
                continue
        print(f"Error executing command: Could not connect to sidecar daemon.")
    elif cmd == "version":
        print("Grex Nexus Sovereign Mothership v1.0.0")
    else:
        print(f"Unknown command: {cmd}. Run 'grex --help' for available commands.")

if __name__ == "__main__":
    main()
